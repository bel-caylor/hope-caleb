{
  "name": "hope-caleb-wedding-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "rimraf dist && node esbuild.config.mjs && npm run copy:html && npm run copy:json && npm run copy:gas",
    "build": "npm run build:core && node scripts/build-standalone.cjs",
    "build:standalone": "npm run build",
    "watch:standalone": "chokidar \"src/**/*\" \"index.html\" \"site.css\" \"slideshow.html\" \"styles.css\" \"script.js\" \"slideshow.css\" \"slideshow.js\" \"images/**/*\" -c \"npm run build\" --initial",
    "copy:html": "copyfiles -f \"src/html/**/*.html\" dist",
    "copy:json": "copyfiles -u 1 \"src/**/*.json\" dist/",
    "copy:gas": "copyfiles -u 1 \"src/**/*.gs\" dist/",
    "planner:check": "node scripts/check-planner-config.cjs",
    "planner:set-url": "node scripts/set-apps-script-url.cjs",
    "planner:sync-deployment": "node scripts/sync-planner-deployment.cjs",
    "serve:standalone": "http-server dist-standalone -p 5173 -c-1",
    "dev:standalone": "concurrently -k \"npm:watch:standalone\" \"npm:serve:standalone\"",
    "push": "clasp push",
    "deploy": "npm run build:core && clasp push -f"
  },
  "devDependencies": {
    "@google/clasp": "^3.2.0",
    "@types/google-apps-script": "^1.0.88",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.25.5",
    "http-server": "^14.1.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
